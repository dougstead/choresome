# Copy this file to .env and adjust as needed.

# PostgreSQL connection. Locally, `npm run db:local` runs a private Postgres
# on port 5433 with databases choresome (hosted), choresome_dev (next dev) and
# choresome_test (vitest), using the passwords in .env.postgres.local:
#   PG_SUPERUSER_PASSWORD="..."   PG_APP_PASSWORD="..."
# In production, point this at a managed or properly installed Postgres.
DATABASE_URL="postgresql://choresome:PASSWORD@localhost:5433/choresome_dev?schema=public"

# --- Hosted (multi-household) service -----------------------------------------

# Public base URL people reach the app on. Used to build invite and
# password-reset links, and to allow same-origin form posts.
APP_URL="http://localhost:3010"

# Port for scripts/start-hosted.mjs (next start).
PORT=3010

# Mark session cookies Secure. Defaults to true when APP_URL is https.
# COOKIE_SECURE=true

# Set to false for invite-only: invite links still create accounts.
SIGNUPS_ENABLED=true

# Only behind a reverse proxy you control: trust X-Forwarded-For / -Host for
# client IPs (rate limiting) and the same-origin check.
TRUST_PROXY=false

# Days of inactivity before a session expires (it slides forward on use).
SESSION_IDLE_DAYS=30

# Server-wide database backups (every household) via pg_dump, which must be on
# PATH or set below. Defaults: <project>/backups, every 24h, keep 14.
# BACKUP_INTERVAL_HOURS=0 turns them off (e.g. your Postgres host backs up).
# BACKUP_DIR="D:/choresome-backups"
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/17/bin/pg_dump.exe"
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14

# Outgoing email for password resets. Leave unset to write emails to
# data/outbox/ instead (fine for development; use `npm run admin -- reset-link`
# to hand someone a link manually).
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# MAIL_FROM="Choresome <no-reply@example.com>"

# --- Development only ----------------------------------------------------------

# Set to "true" only in local development to enable the demo seed script,
# which adds a demo household owned by this login.
SEED_DEMO_DATA="false"
SEED_DEMO_EMAIL="demo@choresome.test"
SEED_DEMO_PASSWORD="demo-household-pass"
