# Copy this file to .env and adjust as needed.

# SQLite database location. Relative paths resolve relative to prisma/schema.prisma,
# so the default below resolves to <project root>/data/choresome.db.
# In Docker, DATABASE_URL is set to an absolute path inside the mounted volume instead.
DATABASE_URL="file:../data/choresome.db"

# Set to "true" only in local development to enable the demo seed script.
SEED_DEMO_DATA="false"
