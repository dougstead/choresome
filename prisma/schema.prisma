// Choresome data model.
//
// Design notes:
// - Multi-household: every household-owned row (Member, Area, Task, NfcTag,
//   CompletionEvent) carries a householdId, and every service function takes
//   the caller's householdId explicitly -- see docs/multi-household.md.
// - User (a login) is deliberately separate from Member (a person chores are
//   credited to, who may never log in -- e.g. a child). HouseholdMembership
//   joins Users to Households.
// - Tasks are never hard-deleted by the UI; they are archived. CompletionEvent
//   rows are the permanent, append-mostly history the app is built around.
// - recurrenceConfig / reminderConfig are validated by Zod at the application
//   boundary (see src/lib/validation) rather than constrained in the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RecurrenceType {
  COMPLETION_RELATIVE
  FIXED_CALENDAR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum MembershipRole {
  OWNER
  MEMBER
}

/// A tenant: one household's identity + settings. All chore data hangs off it.
model Household {
  id       Int    @id @default(autoincrement())
  name     String
  timezone String @default("Europe/London")

  theme              Theme  @default(SYSTEM)
  dateFormat         String @default("DD/MM/YYYY")
  timeFormat         String @default("24h")
  upcomingWindowDays Int    @default(3)
  reminderDefaults   String @default("{\"onDue\":true,\"onOverdue\":true,\"daysBefore\":[],\"hoursBefore\":[]}")

  displayConfig String @default("{\"idleTimeoutSeconds\":90,\"sharedMode\":true,\"screensaverBrightness\":0.4}")

  /// While true, every due-date calculation is pinned to `holidayStartedAt`
  /// instead of the real date, so nothing creeps further overdue while the
  /// household is away. Turning it off is what shifts schedules forward
  /// again -- see holiday-service.ts.
  holidayMode      Boolean   @default(false)
  holidayStartedAt DateTime?

  setupCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      HouseholdMembership[]
  invites          Invite[]
  sessions         Session[]
  members          Member[]
  areas            Area[]
  tasks            Task[]
  nfcTags          NfcTag[]
  completionEvents CompletionEvent[]
}

/// A login. Never credited with chores directly -- that's Member's job.
model User {
  id           String @id @default(cuid())
  /// Stored lower-cased; uniqueness is case-insensitive in practice.
  email        String @unique
  name         String
  /// scrypt hash, see src/lib/auth/password.ts.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    HouseholdMembership[]
  sessions       Session[]
  passwordResets PasswordResetToken[]
  invitesCreated Invite[]              @relation("InviteCreatedBy")
}

model HouseholdMembership {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId Int
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([userId, householdId])
  @@index([householdId])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256
/// hash is stored, so a leaked database can't be replayed as sessions.
model Session {
  id          String     @id @default(cuid())
  tokenHash   String     @unique
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The household this browser is currently looking at (null until the user
  /// has created or joined one).
  householdId Int?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  /// Sliding expiry: pushed forward on use, so an always-on wall display
  /// never gets logged out, but an abandoned session dies.
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
}

/// A shareable "join our household" link. Single-use, time-limited.
model Invite {
  id          String         @id @default(cuid())
  tokenHash   String         @unique
  householdId Int
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(MEMBER)
  createdById String
  createdBy   User           @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([householdId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Member {
  id          String    @id @default(cuid())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  icon        String    @default("🙂")
  color       String? // optional hex accent, e.g. "#4F8EF7"
  active      Boolean   @default(true)
  order       Int       @default(0)
  /// The single system-managed "Joint effort" member, used when a task is done together.
  /// Hidden from member lists/pickers; stats credit a joint completion to every real member.
  isJoint     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultAssigneeFor Task[]            @relation("TaskDefaultAssignee")
  completionEvents   CompletionEvent[]

  @@index([householdId, active, order])
}

model Area {
  id          String    @id @default(cuid())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  icon        String    @default("🏠")
  order       Int       @default(0)
  archived    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([householdId, archived, order])
}

model Task {
  id          String    @id @default(cuid())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  description String?

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  active     Boolean   @default(true)
  archivedAt DateTime?

  recurrenceType   RecurrenceType
  /// JSON — shape depends on recurrenceType, see src/lib/recurrence/types.ts
  recurrenceConfig String

  /// Current due date, stored as a UTC-midnight instant representing a
  /// household-local calendar date (see src/lib/dates.ts).
  dueDate DateTime

  /// JSON ReminderConfig, or null to fall back to household defaults.
  reminderConfig String?

  defaultAssigneeId String?
  defaultAssignee   Member? @relation("TaskDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  estimatedDurationMinutes Int?
  priority                 Priority @default(MEDIUM)
  icon                     String   @default("🧽")
  /// When true, completing always asks who did it and offers "Joint effort".
  allowJoint               Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completionEvents CompletionEvent[]
  nfcTags          NfcTag[]

  @@index([areaId])
  @@index([householdId, active, dueDate])
}

/// A physical NFC sticker (or its QR-code equivalent), identified by a
/// permanent random `token` baked into the tag's URL. `taskId` is the
/// *current* assignment and can be repointed to a different task at any
/// time without touching the physical tag — the token itself never changes.
model NfcTag {
  id          String    @id @default(cuid())
  /// Globally unique (it's baked into a URL), but a tap only completes the
  /// task for a signed-in user of the tag's own household.
  token       String    @unique
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// Friendly name/location, e.g. "Washing machine cupboard".
  label String @default("")

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  active     Boolean   @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([householdId])
}

/// Immutable-by-default log of task completions. The app's history and
/// statistics are derived entirely from these rows. Corrections are made via
/// explicit edit/delete actions in the UI, not by mutating other tables.
model CompletionEvent {
  id          String    @id @default(cuid())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  completedAt DateTime
  note        String?

  /// The due date this completion satisfied, if the task had one at the time.
  dueDateAtCompletion DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, completedAt])
  @@index([memberId, completedAt])
  @@index([householdId, completedAt])
}
